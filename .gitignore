# mcpp build outputs. Every workspace member has its own target/ directory, and
# the pattern below matches them at any depth.
target/
.mcpp/
.cache/

# clangd's index and the compile_commands.json mcpp regenerates on every build.
.cache/clangd/
compile_commands.json

# Supervisor dispatch scripts the agent used while building this; not part of
# the product.
.dispatch/

# Local scratch configurations someone pointed LITEROUTER_CONFIG at.
*.local.json
dev-config.json

# Editor & IDE artifacts
.vscode/
.idea/
*.swp
*~
*.bak

# OS junk
.DS_Store
Thumbs.db

# Logs & temporary files
*.log
*.pid
*.tmp*

# Python bytecode from importing scripts/*.py (check_config_docs.py is run as a
# program by CI, which does not create these, but importing it does).
__pycache__/
*.pyc

# Web console frontend dependencies
web/node_modules/
